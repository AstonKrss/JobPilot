# 复制为 .env 后填写。.env 不要提交到版本库（含密钥）
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/ragjob

# postgres.exe 所在目录（或直接写可执行文件路径）。start.bat / launch.py 用它启动数据库。
# 不填时脚本会自动查找：PATH → conda 环境 → C:/Program Files/PostgreSQL/*
# POSTGRES_BIN=C:/Program Files/PostgreSQL/16/bin

# OpenCode Go 网关（订阅制）。端点用 zen/go/v1，
# 文档里的 inference/go/openai/v1 实测返回 429 Endpoint is unavailable
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
# 网关要求客户端自报身份，不要改成通用 SDK 名
LLM_USER_AGENT=job-agent/0.1.0

# 必须为 true：思考模式会让 temperature 失效，且思考 token 会吃光输出预算
LLM_DISABLE_THINKING=true

LLM_TIMEOUT_S=120
# 单份简历成本上限（元），仅用于超限告警
COST_LIMIT_PER_RESUME=0.5
