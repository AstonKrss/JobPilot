{
  "manifest_version": 3,
  "name": "求职助手",
  "version": "0.6.0",
  "description": "抓取 BOSS/猎聘/智联岗位 JD，按简历算匹配、改简历、生成 HR 回复草稿",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*.zhipin.com/*",
    "http://*.zhipin.com/*",
    "https://*.liepin.com/*",
    "http://*.liepin.com/*",
    "https://*.zhaopin.com/*",
    "http://*.zhaopin.com/*",
    "https://*.zhaopin.cn/*",
    "http://*.zhaopin.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "http://*.zhipin.com/*",
        "https://*.liepin.com/*",
        "http://*.liepin.com/*",
        "https://*.zhaopin.com/*",
        "http://*.zhaopin.com/*",
        "https://*.zhaopin.cn/*",
        "http://*.zhaopin.cn/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "http://*.zhipin.com/*",
        "https://*.liepin.com/*",
        "http://*.liepin.com/*",
        "https://*.zhaopin.com/*",
        "http://*.zhaopin.com/*",
        "https://*.zhaopin.cn/*",
        "http://*.zhaopin.cn/*"
      ],
      "js": [
        "chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "求职助手"
  }
}
