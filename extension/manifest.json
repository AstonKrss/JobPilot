{
  "manifest_version": 3,
  "name": "岗哨 · 本地求职副驾",
  "version": "0.11.0",
  "description": "打开岗位页就自动收录并当场判断你能不能投；盯 HR 回复、按关键词批量找岗。数据只留在本机。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*.zhipin.com/*",
    "http://*.zhipin.com/*",
    "https://*.liepin.com/*",
    "http://*.liepin.com/*",
    "https://*.zhaopin.com/*",
    "http://*.zhaopin.com/*",
    "https://*.zhaopin.cn/*",
    "http://*.zhaopin.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "http://*.zhipin.com/*",
        "https://*.liepin.com/*",
        "http://*.liepin.com/*",
        "https://*.zhaopin.com/*",
        "http://*.zhaopin.com/*",
        "https://*.zhaopin.cn/*",
        "http://*.zhaopin.cn/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "http://*.zhipin.com/*",
        "https://*.liepin.com/*",
        "http://*.liepin.com/*",
        "https://*.zhaopin.com/*",
        "http://*.zhaopin.com/*",
        "https://*.zhaopin.cn/*",
        "http://*.zhaopin.cn/*"
      ],
      "js": [
        "chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "求职助手"
  }
}
