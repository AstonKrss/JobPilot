# 虚拟环境
.venv/

# 运行时数据：上传的简历原文、Postgres 数据目录、日志、临时文件
# 简历属敏感个人信息，绝不可进版本库
data/

# 密钥
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 编辑器
.vscode/
.idea/

# 界面预览页（scripts/preview_ui.py 生成，仅本地调试用）
backend/static/_preview*.html

# 内部工作记录（含真实姓名、联系方式、内部讨论），不进公开仓库
.workbuddy/

# 评测脚本的产物目录（26MB：上传的简历、导出的 docx、抓下来的 js 依赖）。
# 里面有真实简历文件，不能进公开仓库。脚本本身是本地工具，需要时按
# docs/agent-eval-report-*.md 里的命令重建。
.testrun/
